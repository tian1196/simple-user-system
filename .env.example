# Local development. For ECS set /opt/device-ledger/data/ledger.sqlite.
DATABASE_PATH=./data/ledger.sqlite
HOST=127.0.0.1
PORT=3000
APP_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
# false only for local/SSH-tunnel HTTP. Set true with HTTPS before public use.
COOKIE_SECURE=false
# Optional. Encrypts admin TOTP secrets at rest; set a long random string in production.
# MFA_KEY=replace-with-a-long-random-string
