[Unit]
Description=Device Ledger Node API
After=network.target
[Service]
Type=simple
User=deviceledger
Group=deviceledger
WorkingDirectory=/opt/device-ledger/app
Environment=DATABASE_PATH=/opt/device-ledger/data/ledger.sqlite
Environment=HOST=127.0.0.1
Environment=PORT=3000
Environment=APP_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
Environment=COOKIE_SECURE=false
# Internal SSH-tunnel testing only. Configure HTTPS+secure cookies for public use.
ExecStart=/opt/node24/bin/node /opt/device-ledger/app/server/index.js
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/device-ledger/data
[Install]
WantedBy=multi-user.target
