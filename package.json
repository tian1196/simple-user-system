{
  "name": "simple-user-system",
  "version": "1.0.0",
  "private": true,
  "description": "个人设备保修与维护台账",
  "main": "server/index.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env server/index.js",
    "dev": "node --env-file-if-exists=.env server/index.js",
    "admin:dev": "npm --prefix web run dev",
    "admin:build": "npm --prefix web run build",
    "pack": "sh scripts/pack.sh",
    "deploy": "sh scripts/deploy.sh",
    "deploy:https": "sh scripts/deploy.sh --https",
    "upload": "sh scripts/upload.sh",
    "prepare": "husky",
    "commit": "cz",
    "release": "commit-and-tag-version",
    "db:init": "node --env-file-if-exists=.env scripts/db-init.js",
    "db:check": "node --env-file-if-exists=.env scripts/db-check.js",
    "invite:create": "node --env-file-if-exists=.env scripts/create-invite.js",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "uuid": "^11.0.5"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "commit-and-tag-version": "^12.6.0",
    "commitizen": "^4.3.1",
    "cz-conventional-changelog": "^3.3.0",
    "husky": "^9.1.7"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "engines": {
    "node": ">=24.13.0 <25"
  }
}
