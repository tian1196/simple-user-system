{
  "name": "device-ledger-admin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "个人设备台账管理后台（Vue 3 + Element Plus + TypeScript + Axios）",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "build:only": "vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc -b --force",
    "format": "prettier --write \"src/**/*.{vue,ts,scss,css}\""
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "axios": "^1.21.0",
    "element-plus": "^2.14.7",
    "pinia": "^3.0.4",
    "vue": "^3.5.45",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@types/node": "^24.7.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "prettier": "^3.6.2",
    "sass": "^1.108.0",
    "typescript": "~5.9.3",
    "unplugin-auto-import": "^20.3.0",
    "unplugin-vue-components": "^29.2.0",
    "vite": "^7.3.7",
    "vue-tsc": "^3.3.14"
  }
}
